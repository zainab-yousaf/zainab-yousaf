# Copy to .env.local (or .env) for local development, and add the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit the real values.

# ── "Ask my AI" chat ───────────────────────────────────────────────
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemini model to use (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ── Contact form: set up ONE of these two options ──────────────────
# Option A: Resend (https://resend.com). Used when RESEND_API_KEY is set.
RESEND_API_KEY=
# Where messages are delivered
CONTACT_TO_EMAIL=
# Sender address on a domain you verified in Resend. Without one, Resend's test sender
# (onboarding@resend.dev) only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=

# Option B: Formspree (https://formspree.io). The ID is the part after /f/ in your form URL.
FORMSPREE_FORM_ID=
