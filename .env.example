# Copy to .env.local for local development, and add the same variables in Vercel
# (Project → Settings → Environment Variables).

# Google Gemini API key for the "Ask my AI" chat (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Gemini model to use (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
